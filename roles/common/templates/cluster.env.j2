# Managed by Ansible - DO NOT EDIT

K8S_MINOR="{{ kubernetes_minor_version }}"
K8S_VERSION="{{ kubernetes_version }}"
K8S_PACKAGE_VERSION="{{ kubernetes_package_version }}"
CONTAINERD_PACKAGE_VERSION="{{ containerd_package_version }}"
CILIUM_VERSION="{{ cilium_version }}"

API_FQDN="{{ api_fqdn }}"
API_VIP="{{ api_vip }}"
VIP_PREFIX="{{ vip_prefix }}"

POD_CIDR="{{ pod_cidr }}"
SERVICE_CIDR="{{ service_cidr }}"

{% for host in groups['control_plane'] %}
CP{{ loop.index }}_NAME="{{ host }}"
CP{{ loop.index }}_IP="{{ hostvars[host]['ansible_host'] }}"
{% endfor %}
{% for host in groups['workers'] %}
WORKER{{ loop.index }}_NAME="{{ host }}"
WORKER{{ loop.index }}_IP="{{ hostvars[host]['ansible_host'] }}"
{% endfor %}
{% for host in groups['load_balancers'] %}
LB{{ loop.index }}_NAME="{{ host }}"
LB{{ loop.index }}_IP="{{ hostvars[host]['ansible_host'] }}"
{% endfor %}
