# Managed by Ansible - DO NOT EDIT

K8S_MINOR="{{ kubernetes_minor_version }}"
K8S_VERSION="{{ kubernetes_version }}"
K8S_PACKAGE_VERSION="{{ kubernetes_package_version }}"
CONTAINERD_PACKAGE_VERSION="{{ containerd_package_version }}"
CILIUM_VERSION="{{ cilium_version }}"

API_FQDN="{{ api_fqdn }}"
API_VIP="{{ api_vip }}"
VIP_PREFIX="{{ vip_prefix }}"

POD_CIDR="{{ pod_cidr }}"
SERVICE_CIDR="{{ service_cidr }}"

CP1_NAME="{{ groups['control_plane'][0] }}"
CP1_IP="{{ hostvars[groups['control_plane'][0]]['ansible_host'] }}"
CP2_NAME="{{ groups['control_plane'][1] }}"
CP2_IP="{{ hostvars[groups['control_plane'][1]]['ansible_host'] }}"
CP3_NAME="{{ groups['control_plane'][2] }}"
CP3_IP="{{ hostvars[groups['control_plane'][2]]['ansible_host'] }}"

WORKER1_NAME="{{ groups['workers'][0] }}"
WORKER1_IP="{{ hostvars[groups['workers'][0]]['ansible_host'] }}"
WORKER2_NAME="{{ groups['workers'][1] }}"
WORKER2_IP="{{ hostvars[groups['workers'][1]]['ansible_host'] }}"
WORKER3_NAME="{{ groups['workers'][2] }}"
WORKER3_IP="{{ hostvars[groups['workers'][2]]['ansible_host'] }}"

LB1_NAME="{{ groups['load_balancers'][0] }}"
LB1_IP="{{ hostvars[groups['load_balancers'][0]]['ansible_host'] }}"
LB2_NAME="{{ groups['load_balancers'][1] }}"
LB2_IP="{{ hostvars[groups['load_balancers'][1]]['ansible_host'] }}"
