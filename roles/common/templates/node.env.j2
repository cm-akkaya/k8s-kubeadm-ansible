# Managed by Ansible - DO NOT EDIT

NODE_NAME="{{ inventory_hostname }}"
NODE_IP="{{ k8s_node_ip }}"
NODE_INTERFACE="{{ k8s_interface }}"
{% if 'control_plane' in group_names %}
NODE_ROLE="control-plane"
{% elif 'workers' in group_names %}
NODE_ROLE="worker"
{% elif 'load_balancers' in group_names %}
NODE_ROLE="load-balancer"
{% endif %}
